# Supabase project settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # "service_role" key, NOT the anon key. Keep secret.

# Pick your own password for signing into the board.
ADMIN_PASSWORD=change-me

# Random long string, used to derive the session cookie. Any random value works.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-too

# Must match the value Vercel sends when it invokes /api/sync via cron.
# Set this in Vercel's Project Settings -> Environment Variables; Vercel
# automatically sends it as `Authorization: Bearer $CRON_SECRET` to your
# Cron Job routes when this env var is present.
CRON_SECRET=change-me-three
